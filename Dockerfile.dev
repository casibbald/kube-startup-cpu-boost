# Development Dockerfile for kube-startup-cpu-boost (Tilt/local dev)
# Binary is built on host and copied in
# Uses distroless base for minimal runtime

ARG TARGETPLATFORM=linux/amd64
FROM gcr.io/distroless/static:nonroot

WORKDIR /

# Copy pre-built binary from bin directory
# Note: Binary must exist before Docker build (ensured by Tilt deps or local build)
# Path is relative to context (project root), so bin/ is at the root
# COPY preserves file permissions, so the binary will be executable
COPY --chmod=755 bin/manager /manager

USER 65532:65532

# Run the manager
ENTRYPOINT ["/manager"]
