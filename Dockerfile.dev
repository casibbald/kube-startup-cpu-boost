# Development Dockerfile for kube-startup-cpu-boost (Tilt/local dev)
# Binary is built on host and copied in
# Uses distroless base for minimal runtime

# Stage 1: Verify binary exists and is executable
FROM alpine:3.19 AS verify
WORKDIR /verify
# Copy pre-built binary from bin directory
COPY bin/manager /verify/manager
# Verify binary exists, has non-zero size, and is executable
RUN test -f /verify/manager && \
    test -s /verify/manager && \
    test -x /verify/manager && \
    echo "✅ Binary verification passed: $(ls -lh /verify/manager)" || \
    (echo "❌ ERROR: Binary verification failed" && exit 1)

# Stage 2: Verify copy works (intermediate verification stage)
FROM alpine:3.19 AS copy-verify
WORKDIR /
# Copy from verify stage to test the copy works
COPY --from=verify /verify/manager /copy-verify/manager
# Verify the copy succeeded
RUN test -f /copy-verify/manager && \
    test -s /copy-verify/manager && \
    test -x /copy-verify/manager && \
    echo "✅ Copy verification passed: $(ls -lh /copy-verify/manager)" || \
    (echo "❌ ERROR: Binary copy failed" && exit 1)

# Stage 3: Final distroless image (copy from verified stage)
FROM gcr.io/distroless/static:nonroot
WORKDIR /

# Copy verified binary from copy-verify stage (proven to work)
COPY --from=copy-verify --chmod=755 /copy-verify/manager /manager

USER 65532:65532

# Run the manager
ENTRYPOINT ["/manager"]
