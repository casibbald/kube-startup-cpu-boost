# Development Dockerfile for kube-startup-cpu-boost (Tilt/local dev)
# Binary is built on host (via Tiltfile build-manager) and copied into container
# Uses alpine base for simplicity and debugging tools

FROM alpine:3.19
WORKDIR /

# Create a non-root user for running the manager
# Using UID 1000 (standard non-root user) and GID 1000
RUN addgroup -g 1000 nonroot && \
    adduser -D -u 1000 -G nonroot nonroot

# Copy pre-built binary from bin directory (built by Tiltfile build-manager)
# Binary must exist in build context before Docker build runs
COPY --chmod=755 bin/manager /manager

# Verify binary exists and is valid (fail build if missing)
RUN test -f /manager && \
    test -s /manager && \
    test -x /manager && \
    echo "✅ Binary verification passed: $(ls -lh /manager)" || \
    (echo "❌ ERROR: Binary missing or invalid at /manager" && exit 1)

# Switch to non-root user
USER nonroot:nonroot

# Run the manager
ENTRYPOINT ["/manager"]
